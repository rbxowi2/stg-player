+                removeminmax(gaussians, maxbounds, minbounds)
+        return flag
+    
+    elif densify == 2: # n3d 
+        if iteration < opt.densify_until_iter :
+            # STG_OMEGA_ITER: when omega/rotation are split into groups (hard-coded 8001 upstream).
+            #
+            #    This step splits the Gaussians into "moving, keep omega" and "static, freeze omega and
+            #    learn rotation". It **assumes densification has ended** - with the original desicnt=6,
+            #    densification stops at iter 1100, long before 8001, so there is no problem.
+            #    Once densification is extended past 8001 to grow more Gaussians, the assumption breaks
+            #    (omegamask does not grow with added points -> prune_points raises IndexError).
+            #
+            #    So: (1) the timing is configurable and must come after densification ends
+            #          (2) if the mask is invalidated by added points (set to None by prune_points), rebuild it;
+            #             `zero_omegabymotion()` is a pure function, safe to recompute.
+            #    Without this variable the default is 8001, the same as the original code.
+            _oit = int(os.environ.get("STG_OMEGA_ITER", "8001"))
+            if iteration >= _oit and gaussians.omegamask is None:
+                omegamask = gaussians.zero_omegabymotion()
+                gaussians.omegamask = omegamask
+                scene.recordpoints(iteration, "seperate omega"
+                                   + str(torch.sum(omegamask).item()))
+            elif iteration > _oit:
+                freezweightsbymasknounsqueeze(gaussians, ["_omega"], gaussians.omegamask)
+                rotationmask = torch.logical_not(gaussians.omegamask)
+                freezweightsbymasknounsqueeze(gaussians, ["_rotation"], rotationmask)
+            if iteration > opt.densify_from_iter and iteration % opt.densification_interval == 0:
+                # STG_GNUM_MAX: hard cap on the number of Gaussians.
+                #    `opt.gnumlimit` is **defined in the repo but never used**,
+                #    so upstream has no way to control the total number of Gaussians - desicnt only
+                #    controls how many times they grow; the final count is a result, not a setting.
+                #    Without this environment variable the behaviour is identical to the original code.
+                import os as _os
+                _gmax = _os.environ.get("STG_GNUM_MAX")
+                _full = _gmax and gaussians._xyz.shape[0] >= int(_gmax)
+                if flag < opt.desicnt and not _full:
+                    scene.recordpoints(iteration, "before densify")
+                    size_threshold = 20 if iteration > opt.opacity_reset_interval else None
+                    gaussians.densify_pruneclone(opt.densify_grad_threshold, opt.opthr, scene.cameras_extent, size_threshold)
