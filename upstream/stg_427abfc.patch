+# STG_TIMES: continuous time support. See readColmapCameras below.
+_STG_TIMES = None
+
+
+# STG_TIME_RANGE: train only a range of time steps, for example "50,105" (**both ends included**, 56 in total).
+#
+#    Why: a 301-frame take is one long clip; the user often wants a model of
+#    just a few seconds of it. Cutting it in preprocessing would produce a
+#    second dataset folder, and the studio's dataset finder refuses to run
+#    when there is more than one -- so the cut belongs here.
+#    Set by the studio's time range field.
+#
+#    Times inside the range are renormalised to 0~1 so the model is a
+#    self-contained short clip (the player always plays 0~1).
+#    Not setting the variable behaves exactly like the original code.
+_STG_RANGE = None                # (a, b), or False = not set
+_STG_RANGE_T = None              # (lo, hi): smallest/largest timestamp inside the range
+
+
+def _stg_range():
+    global _STG_RANGE
+    if _STG_RANGE is None:
+        v = os.environ.get("STG_TIME_RANGE", "").strip()
+        if not v:
+            _STG_RANGE = False
+        else:
+            parts = [x for x in v.replace(" ", "").split(",") if x]
+            if len(parts) != 2:
+                raise ValueError(f"STG_TIME_RANGE must be a,b (got {v!r})")
+            a, b = int(parts[0]), int(parts[1])
+            if b < a:
+                raise ValueError(f"STG_TIME_RANGE ends before it starts: {v!r}")
+            _STG_RANGE = (a, b)
+            print(f"[time-range] training only time steps {a}~{b} ({b - a + 1} in total)")
+    return _STG_RANGE
+
+
+def _stg_range_t():
+    """(smallest, largest) of all timestamps in the range - the two ends for renormalising.
+
+    Uses the smallest and largest of the **whole time-step group**, not of one camera: the four
+    cameras in one colmap_j already have different times (that is what continuous time expresses).
+    """
+    global _STG_RANGE_T
+    if _STG_RANGE_T is None:
+        a, b = _STG_RANGE
+        ts = [float(v) for k, v in _STG_TIMES.items()
+              if a <= int(k.split("/")[0]) <= b]
+        if not ts:
+            raise ValueError(f"STG_TIMES has no data for time steps {a}~{b}")
+        _STG_RANGE_T = (min(ts), max(ts))
+    return _STG_RANGE_T
+
+
+def _stg_t(j, startime, duration, extr_name):
+    """Normalised time of this image. Without STG_TIMES identical to the original code."""
+    global _STG_TIMES
+    if _STG_TIMES is None:
+        f = os.environ.get("STG_TIMES", "").strip()
+        _STG_TIMES = json.load(open(f, encoding="utf-8")) if f else {}
+        if _STG_TIMES:
+            print(f"[times] continuous time: {f} -> {len(_STG_TIMES)} timestamps")
+    if not _STG_TIMES:
+        return (j - startime) / duration
+    k = f"{j}/{os.path.basename(extr_name)}"
+    if k not in _STG_TIMES:
+        raise KeyError(f"STG_TIMES is missing {k}")
+    t = float(_STG_TIMES[k])
+    if not _stg_range():
+        return t
+    lo, hi = _stg_range_t()          # renormalise to 0~1 inside the range
+    return (t - lo) / (hi - lo) if hi > lo else 0.0
