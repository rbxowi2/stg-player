+                else:
+                    prune_mask =  (gaussians.get_opacity < opt.opthr).squeeze()
+                    gaussians.prune_points(prune_mask)
+                    torch.cuda.empty_cache()
+                    scene.recordpoints(iteration, "addionally prune_mask")
+            if iteration % 3000 == 0 :
+                gaussians.reset_opacity()
+        else:
+            pass 
+        return flag
+    
+
+    elif densify == 3: # techni
